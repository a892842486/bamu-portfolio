<nav
  class="bg-[#F5F1E8] dark:bg-[#292723]"
  data-controller="theme"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">

      <!-- Brand -->
      <%= link_to root_path,
                  class: "rounded-lg px-10 py-2 text-2xl font-semibold tracking-tight
                          text-[#25231F] dark:text-[#F5F1E8] transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35] hover:text-[#25231F] dark:hover:text-[#FFFFFF]" do %>
        Bamu
      <% end %>

      <!-- Desktop navigation -->
      <div class="hidden items-center gap-2 md:flex">
        <%= link_to "HOME",
                    root_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(root_path) ? 'bg-[#E8E4DA] dark:bg-[#403C35] text-[#55524B] dark:text-[#D6D0C5]' : 'text-[#55524B] dark:text-[#D6D0C5]'}
                            transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35] hover:text-[#25231F] dark:hover:text-[#FFFFFF]" %>

        <%= link_to "About", root_path(anchor: "about"),
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35] hover:text-[#25231F] dark:hover:text-[#FFFFFF]" %>

        <%= link_to "Projects",
                    projects_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(projects_path) ? 'bg-[#E8E4DA] dark:bg-[#403C35] text-[#55524B] dark:text-[#D6D0C5]' : 'text-[#55524B] dark:text-[#D6D0C5]'}
                            transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35] hover:text-[#25231F] dark:hover:text-[#FFFFFF]" %>

        <%= link_to "Blog",
                    readings_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(readings_path) ? 'bg-[#E8E4DA] dark:bg-[#403C35] text-[#55524B] dark:text-[#D6D0C5]' : 'text-[#55524B] dark:text-[#D6D0C5]'}
                            transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35] hover:text-[#25231F] dark:hover:text-[#FFFFFF]" %>

        <%= link_to "Contact",
                    contact_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(contact_path) ? 'bg-[#E8E4DA] dark:bg-[#403C35] text-[#55524B] dark:text-[#D6D0C5]' : 'text-[#55524B] dark:text-[#D6D0C5]'}
                            transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35] hover:text-[#25231F] dark:hover:text-[#FFFFFF]" %>

        <button
          type="button"
          data-action="click->theme#toggle"
          class="flex h-10 w-10 items-center justify-center rounded-lg
                text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#E8E4DA] dark:hover:bg-[#403C35]
                hover:text-[#25231F] dark:hover:text-[#FFFFFF]"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <i class="fa-solid fa-moon" aria-hidden="true"></i>
        </button>
      </div>

      <!-- Mobile navigation -->
      <details class="relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]"
          aria-label="Open navigation"
        >
          <span class="text-2xl leading-none">☰</span>
        </summary>

        <div class="absolute right-0 top-12 z-50 w-44 rounded-xl border border-[#DDD8CC] dark:border-[#504B43] bg-[#FFFCF7] dark:bg-[#302D28] py-2 shadow-lg">
          <%= link_to "HOME", root_path,
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]" %>
          <%= link_to "About", root_path(anchor: "about"),
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]" %>
          <%= link_to "Projects", projects_path,
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]" %>
          <%= link_to "Blog", readings_path,
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]" %>
          <%= link_to "Contact", contact_path,
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]" %>
          <button
            type="button"
            data-action="click->theme#toggle"
            class="flex w-full items-center gap-3 px-4 py-3 text-sm
                  font-medium text-[#55524B] dark:text-[#D6D0C5] transition hover:bg-[#EDE8DC] dark:hover:bg-[#403C35]"
          >
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
            Toggle dark mode
          </button>
        </div>
      </details>

    </div>
  </div>
</nav>