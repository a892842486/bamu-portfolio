<nav class="bg-[#F5F1E8]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">

      <!-- Brand -->
      <%= link_to root_path,
                  class: "rounded-lg px-10 py-2 text-2xl font-semibold tracking-tight
                          text-[#25231F] transition hover:bg-[#E8E4DA] hover:text-[#25231F]" do %>
        Bamu
      <% end %>

      <!-- Desktop navigation -->
      <div class="hidden items-center gap-2 md:flex">
        <%= link_to "HOME",
                    root_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(root_path) ? 'bg-[#E8E4DA] text-[#55524B]' : 'text-[#55524B]'}
                            transition hover:bg-[#E8E4DA] hover:text-[#25231F]" %>

        <%= link_to "About", root_path(anchor: "about"),
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide text-[#55524B] transition hover:bg-[#E8E4DA] hover:text-[#25231F]" %>

        <%= link_to "Projects",
                    projects_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(projects_path) ? 'bg-[#E8E4DA] text-[#55524B]' : 'text-[#55524B]'}
                            transition hover:bg-[#E8E4DA] hover:text-[#25231F]" %>

        <%= link_to "Contact",
                    contact_path,
                    class: "rounded-lg px-10 py-2 text-base font-medium tracking-wide
                            #{current_page?(contact_path) ? 'bg-[#E8E4DA] text-[#55524B]' : 'text-[#55524B]'}
                            transition hover:bg-[#E8E4DA] hover:text-[#25231F]" %>
      </div>

      <!-- Mobile navigation -->
      <details class="relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg text-[#55524B] transition hover:bg-[#EDE8DC]"
          aria-label="Open navigation"
        >
          <span class="text-2xl leading-none">☰</span>
        </summary>

        <div class="absolute right-0 top-12 z-50 w-44 rounded-xl border border-[#DDD8CC] bg-[#FFFCF7] py-2 shadow-lg">
          <%= link_to "About", root_path(anchor: "about"),
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] transition hover:bg-[#EDE8DC]" %>
          <%= link_to "Projects", projects_path,
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] transition hover:bg-[#EDE8DC]" %>

          <%= link_to "Contact", contact_path,
                      class: "block px-4 py-3 text-sm font-medium text-[#55524B] transition hover:bg-[#EDE8DC]" %>
        </div>
      </details>

    </div>
  </div>
</nav>