<footer class="bg-[#DED9CD] py-8 text-center text-sm text-[#77736A]">
  <div class="flex flex-col items-center gap-6">
    <% github_link = Profile.first.links.find { |link| link.label.downcase == "github" } %>

    <!-- Icons -->
    <div class="flex items-center gap-6">
      <%= link_to github_link.url,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "text-[#6F6B63] transition hover:text-[#4F4B43]",
                  aria: { label: "GitHub" } do %>
        <i class="fa-brands fa-github text-xl" aria-hidden="true"></i>
      <% end %>

      <% if user_signed_in? %>

        <%= link_to admin_projects_path,
                    class: "text-[#6F6B63] transition hover:text-[#4F4B43]",
                    aria: { label: "Admin Projects" } do %>
          <i class="fa-solid fa-gear text-xl" aria-hidden="true"></i>
        <% end %>

<%= link_to destroy_user_session_path,
            data: { turbo_method: :delete },
            class: "text-[#6F6B63] transition hover:text-[#4F4B43]",
            aria: { label: "Logout" } do %>
  <i class="fa-solid fa-right-from-bracket text-xl" aria-hidden="true"></i>
<% end %>

      <% else %>

        <%= link_to new_user_session_path,
                    class: "text-[#6F6B63] transition hover:text-[#4F4B43]",
                    aria: { label: "Login" } do %>
          <i class="fa-solid fa-circle-user text-xl" aria-hidden="true"></i>
        <% end %>

      <% end %>

    </div>

    <!-- copyright -->
    <p>
      © <%= Time.current.year %> Bamu. All rights reserved.
    </p>
  </div>
</footer>