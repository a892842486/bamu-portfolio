<%= form_with model: @profile, url: admin_profile_path do |form| %>
  <div class="space-y-8">

    <!-- Profile Information -->
    <section class="rounded-2xl bg-[#EEEAE0] dark:bg-[#302D28] p-8">
      <h2 class="text-xl font-semibold text-[#4F4B43] dark:text-[#E5DED2]">
        Profile Information
      </h2>

      <div class="mt-6 space-y-6">

        <div>
          <%= form.label :display_name,
                         class: "block text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2]" %>

          <%= form.text_field :display_name,
                              class: "mt-2 w-full rounded-lg border border-[#CFC9BB] dark:border-[#625B50] bg-[#F5F1E8] dark:bg-[#292723] px-4 py-3 text-[#4F4B43] dark:text-[#E5DED2] outline-none transition focus:border-[#77736A] dark:focus:border-[#B8B0A4]" %>
        </div>

        <div>
          <%= form.label :job_title,
                         class: "block text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2]" %>

          <%= form.text_field :job_title,
                              class: "mt-2 w-full rounded-lg border border-[#CFC9BB] dark:border-[#625B50] bg-[#F5F1E8] dark:bg-[#292723] px-4 py-3 text-[#4F4B43] dark:text-[#E5DED2] outline-none transition focus:border-[#77736A] dark:focus:border-[#B8B0A4]" %>
        </div>

        <div>
          <%= form.label :introduction,
                         class: "block text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2]" %>

          <%= form.text_area :introduction,
                             rows: 7,
                             class: "mt-2 w-full rounded-lg border border-[#CFC9BB] dark:border-[#625B50] bg-[#F5F1E8] dark:bg-[#292723] px-4 py-3 leading-7 text-[#4F4B43] dark:text-[#E5DED2] outline-none transition focus:border-[#77736A] dark:focus:border-[#B8B0A4]" %>
        </div>

        <div>
          <%= form.label :contact_email,
                         class: "block text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2]" %>

          <%= form.email_field :contact_email,
                               class: "mt-2 w-full rounded-lg border border-[#CFC9BB] dark:border-[#625B50] bg-[#F5F1E8] dark:bg-[#292723] px-4 py-3 text-[#4F4B43] dark:text-[#E5DED2] outline-none transition focus:border-[#77736A] dark:focus:border-[#B8B0A4]" %>
        </div>

      </div>
    </section>


    <!-- Links -->
    <section class="rounded-2xl bg-[#EEEAE0] dark:bg-[#302D28] p-8">
      <h2 class="text-xl font-semibold text-[#4F4B43] dark:text-[#E5DED2]">
        Links
      </h2>

      <div class="mt-6 space-y-6">
        <%= form.fields_for :links do |link_form| %>
          <div class="rounded-xl bg-[#DED9CD] dark:bg-[#403C35] p-6">

            <div class="space-y-5">

              <div>
                <%= link_form.label :label,
                                   class: "block text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2]" %>

                <%= link_form.text_field :label,
                                         class: "mt-2 w-full rounded-lg border border-[#CFC9BB] dark:border-[#625B50] bg-[#F5F1E8] dark:bg-[#292723] px-4 py-3 text-[#4F4B43] dark:text-[#E5DED2] outline-none transition focus:border-[#77736A] dark:focus:border-[#B8B0A4]" %>
              </div>

              <div>
                <%= link_form.label :url,
                                   class: "block text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2]" %>

                <%= link_form.url_field :url,
                                        class: "mt-2 w-full rounded-lg border border-[#CFC9BB] dark:border-[#625B50] bg-[#F5F1E8] dark:bg-[#292723] px-4 py-3 text-[#4F4B43] dark:text-[#E5DED2] outline-none transition focus:border-[#77736A] dark:focus:border-[#B8B0A4]" %>
              </div>

            </div>
          </div>
        <% end %>
      </div>
    </section>


    <!-- Actions -->
    <div class="flex justify-end gap-3">
      <%= link_to "Cancel",
                  admin_profile_path,
                  class: "rounded-lg border border-[#CFC9BB] dark:border-[#625B50] px-5 py-3 font-medium text-[#77736A] dark:text-[#B8B0A4] transition hover:bg-[#EEEAE0] dark:hover:bg-[#403C35]" %>

      <%= form.submit class: "rounded-lg bg-[#4F4B43] dark:bg-[#514B42] px-6 py-3 font-medium text-[#F5F1E8] transition hover:bg-[#55524B] dark:hover:bg-[#625B50]" %>
    </div>

  </div>
<% end %>