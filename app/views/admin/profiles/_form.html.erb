<%= form_with model: @profile, url: admin_profile_path do |form| %>
  <div>
    <%= form.label :display_name %>
    <%= form.text_field :display_name %>
  </div>

  <div>
    <%= form.label :job_title %>
    <%= form.text_field :job_title %>
  </div>

  <div>
    <%= form.label :introduction %>
    <%= form.text_area :introduction %>
  </div>

  <div>
    <%= form.label :contact_email %>
    <%= form.email_field :contact_email %>
  </div>

  <div>
    <%= form.fields_for :links do |link_form| %>
      <div>
        <%= link_form.label :label %>
        <%= link_form.text_field :label %>
      </div>

      <div>
        <%= link_form.label :url %>
        <%= link_form.url_field :url %>
      </div>
    <% end %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>