<div class="mx-auto max-w-4xl px-6 py-16">
  <div class="mb-12 flex items-end justify-between">
    <div>
      <p class="text-sm font-medium tracking-widest text-[#77736A] dark:text-[#B8B0A4] uppercase">
        Admin
      </p>

      <div class="flex items-baseline gap-5">
        <h1 class="text-4xl font-semibold tracking-tight text-[#4F4B43] dark:text-[#E5DED2]">
          Projects
        </h1>

        <div class="flex items-center gap-4 text-sm">
          <%= link_to "Projects",
                      admin_projects_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF]" %>

          <%= link_to "Profile",
                      admin_profile_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF]" %>

          <%= link_to "Skills",
                      admin_skills_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF]" %>

          <%= link_to "Readings",
                      admin_readings_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF]" %>
        </div>
      </div>

      <p class="mt-3 text-[#77736A] dark:text-[#B8B0A4]">
        Manage the projects displayed in your portfolio.
      </p>
    </div>

    <%= link_to "New Project",
                new_admin_project_path,
                class: "rounded-lg bg-[#4F4B43] dark:bg-[#514B42] px-5 py-3 font-medium text-[#F5F1E8] transition hover:bg-[#55524B] dark:hover:bg-[#625B50]" %>
  </div>

  <div class="space-y-8">
    <% @projects.each do |project| %>
      <div class="overflow-hidden rounded-2xl bg-[#EEEAE0] dark:bg-[#302D28]">
        <% cover_image = project.project_images.order(:created_at).first %>

        <% if cover_image&.image&.attached? %>
          <div class="flex max-h-[500px] items-center justify-center bg-[#DED9CD] dark:bg-[#403C35] p-4">
            <%= image_tag cover_image.image,
                          class: "max-h-[500px] max-w-full rounded-lg object-contain" %>
          </div>
        <% end %>

        <div class="p-8">
          <h2 class="text-2xl font-semibold text-[#4F4B43] dark:text-[#E5DED2]">
            <%= project.name %>
          </h2>

          <p class="mt-2 text-lg text-[#77736A] dark:text-[#B8B0A4]">
            <%= project.summary %>
          </p>

          <p class="mt-5 max-w-3xl leading-7 text-[#77736A] dark:text-[#B8B0A4]">
            <%= simple_format(project.description) %>
          </p>

          <% if project.skills.any? %>
            <div class="mt-6 flex flex-wrap gap-2">
              <% project.skills.each do |skill| %>
                <span class="rounded-full bg-[#DED9CD] dark:bg-[#403C35] px-3 py-1 text-sm text-[#4F4B43] dark:text-[#E5DED2]">
                  <%= skill.name %>
                </span>
              <% end %>
            </div>
          <% end %>

          <% if project.links.any? %>
            <div class="mt-6 flex flex-wrap gap-4">
              <% project.links.each do |link| %>
                <%= link_to link.label,
                            link.url,
                            target: "_blank",
                            rel: "noopener noreferrer",
                            class: "text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2] underline decoration-[#BDB7AA] dark:decoration-[#625B50] underline-offset-4 transition hover:text-[#77736A] dark:hover:text-[#FFFFFF]" %>
              <% end %>
            </div>
          <% end %>

          <div class="mt-8 flex gap-3">
            <%= link_to "Edit",
                        edit_admin_project_path(project),
                        class: "rounded-lg bg-[#4F4B43] dark:bg-[#514B42] px-5 py-2.5 font-medium text-[#F5F1E8] transition hover:bg-[#55524B] dark:hover:bg-[#625B50]" %>

            <%= button_to "Delete",
                          admin_project_path(project),
                          method: :delete,
                          data: { turbo_confirm: "確定要刪除「#{project.name}」嗎？此操作無法復原。" },
                          class: "rounded-lg border border-[#CFC9BB] dark:border-[#625B50] px-5 py-2.5 font-medium text-[#77736A] dark:text-[#B8B0A4] transition hover:bg-[#DED9CD] dark:hover:bg-[#403C35]" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>