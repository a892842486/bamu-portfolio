<div class="mx-auto max-w-4xl px-6 py-16">
  <div class="mb-12 flex items-end justify-between">
    <div>
      <p class="text-sm font-medium tracking-widest text-[#77736A] dark:text-[#B8B0A4] uppercase">
        Admin
      </p>

      <div class="flex items-baseline gap-5">
        <h1 class="text-4xl font-semibold tracking-tight text-[#4F4B43] dark:text-[#E5DED2]">
          Skills
        </h1>

        <div class="flex items-center gap-4 text-sm">
          <%= link_to "Projects",
                      admin_projects_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF] dark:text-[#E5DED2]" %>

          <%= link_to "Profile",
                      admin_profile_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF] dark:text-[#E5DED2]" %>

          <%= link_to "Skills",
                      admin_skills_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF] dark:text-[#E5DED2]" %>

          <%= link_to "Readings",
                      admin_readings_path,
                      class: "text-[#77736A] dark:text-[#B8B0A4] transition hover:text-[#4F4B43] dark:hover:text-[#FFFFFF] dark:text-[#E5DED2]" %>
        </div>
      </div>

      <p class="mt-3 text-[#77736A] dark:text-[#B8B0A4]">
        Manage the skills displayed in your portfolio.
      </p>
    </div>

    <%= link_to "New Skill",
                new_admin_skill_path,
                class: "rounded-lg bg-[#4F4B43] dark:bg-[#514B42] px-5 py-3 font-medium text-[#F5F1E8] transition hover:bg-[#55524B] dark:hover:bg-[#625B50]" %>
  </div>


  <div id="skills"
       data-controller="skill-sort"
       class="space-y-3">

    <% @skills.each do |skill| %>
      <div data-skill-id="<%= skill.id %>"
          draggable="true"
          data-action="dragstart->skill-sort#dragstart
                      dragover->skill-sort#dragover
                      drop->skill-sort#drop"
          class="flex cursor-grab items-center justify-between rounded-xl bg-[#EEEAE0] dark:bg-[#302D28] p-5 active:cursor-grabbing">

        <div class="flex items-center gap-3">
          <i class="fa-solid fa-grip-vertical text-[#77736A] dark:text-[#B8B0A4]"
            aria-hidden="true"></i>

          <p class="font-medium text-[#4F4B43] dark:text-[#E5DED2]">
            <%= skill.name %>
          </p>
        </div>

        <div class="flex items-center gap-3">
          <%= link_to "Edit",
                      edit_admin_skill_path(skill),
                      class: "rounded-lg border border-[#CFC9BB] dark:border-[#625B50] px-4 py-2 text-sm font-medium text-[#4F4B43] dark:text-[#E5DED2] transition hover:bg-[#DED9CD] dark:hover:bg-[#403C35]" %>

          <%= button_to "Delete",
                        admin_skill_path(skill),
                        method: :delete,
                        class: "rounded-lg border border-[#CFC9BB] dark:border-[#625B50] px-4 py-2 text-sm font-medium text-[#77736A] dark:text-[#B8B0A4] transition hover:bg-[#DED9CD] dark:hover:bg-[#403C35]" %>
        </div>
      </div>
    <% end %>

  </div>
</div>