<div class="mx-auto max-w-4xl px-6 py-16">
  <div class="mb-12 flex items-end justify-between">
    <div>
      <p class="text-sm font-medium tracking-widest text-[#77736A] uppercase">
        Admin
      </p>

      <div class="flex flex-wrap items-baseline gap-5">
        <h1 class="text-4xl font-semibold tracking-tight text-[#4F4B43]">
          Readings
        </h1>

        <div class="flex items-center gap-4 text-sm">
          <%= link_to "Projects",
                      admin_projects_path,
                      class: "text-[#77736A] transition hover:text-[#4F4B43]" %>

          <%= link_to "Profile",
                      admin_profile_path,
                      class: "text-[#77736A] transition hover:text-[#4F4B43]" %>

          <%= link_to "Skills",
                      admin_skills_path,
                      class: "text-[#77736A] transition hover:text-[#4F4B43]" %>

          <%= link_to "Readings",
                      admin_readings_path,
                      class: "text-[#77736A] transition hover:text-[#4F4B43]" %>
        </div>
      </div>

      <p class="mt-3 text-[#77736A]">
        Manage your reading notes and articles.
      </p>
    </div>

    <div class="flex shrink-0 gap-3">
      <%= link_to "New Reading",
                  new_admin_reading_path,
                  class: "rounded-lg bg-[#4F4B43] px-5 py-3 font-medium text-[#F5F1E8] transition hover:bg-[#55524B]" %>

      <%= button_to "Backup",
                    backup_admin_readings_path,
                    method: :post,
                    data: {
                      turbo_confirm: "確定要備份文章嗎？這會覆蓋目前的離線備份資料。"
                    },
                    class: "rounded-lg border border-[#CFC9BB] px-5 py-3 font-medium text-[#77736A] transition hover:bg-[#DED9CD]" %>
    </div>
  </div>

  <% if @readings.any? %>
    <div class="space-y-4">
      <% @readings.each do |reading| %>
        <div class="rounded-2xl bg-[#EEEAE0] p-6">
          <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <h2 class="text-xl font-semibold text-[#4F4B43]">
                <%= reading.title %>
              </h2>

              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[#77736A]">
                <p>
                  Read:
                  <%= reading.read_at&.strftime("%Y-%m-%d") || "Not specified" %>
                </p>

                <p>
                  Created:
                  <%= reading.created_at.strftime("%Y-%m-%d") %>
                </p>
              </div>
            </div>

            <div class="flex shrink-0 gap-3">
              <%= link_to "Edit",
                          edit_admin_reading_path(reading),
                          class: "rounded-lg bg-[#4F4B43] px-5 py-2.5 font-medium text-[#F5F1E8] transition hover:bg-[#55524B]" %>

              <%= button_to "Delete",
                            admin_reading_path(reading),
                            method: :delete,
                            data: {
                              turbo_confirm: "確定要刪除「#{reading.title}」嗎？此操作無法復原。"
                            },
                            class: "rounded-lg border border-[#CFC9BB] px-5 py-2.5 font-medium text-[#77736A] transition hover:bg-[#DED9CD]" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl bg-[#EEEAE0] px-6 py-12 text-center">
      <p class="text-[#77736A]">
        No readings yet. Start by adding your first reading.
      </p>

      <%= link_to "New Reading",
                  new_admin_reading_path,
                  class: "mt-5 inline-block rounded-lg bg-[#4F4B43] px-5 py-3 font-medium text-[#F5F1E8] transition hover:bg-[#55524B]" %>
    </div>
  <% end %>
</div>