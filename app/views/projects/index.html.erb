<div class="bg-[#F5F1E8] px-4 py-20">
  <div class="mx-auto max-w-5xl">
    <div class="mb-20 text-center">
      <h1 class="text-5xl font-semibold tracking-tight text-[#25231F]">
        My Projects
      </h1>

      <p class="mt-4 text-lg text-[#77736A]">
        Projects I've built while learning and exploring web development.
      </p>
    </div>

    <div class="space-y-16">
      <% @projects.each do |project| %>
        <article class="overflow-hidden rounded-2xl bg-[#EEEAE0]">

          <% cover_image = project.project_images.order(:created_at).first %>

          <% if cover_image&.image&.attached? %>
            <%= link_to project_path(project),
                        class: "block bg-[#DED9CD] p-4" do %>
              <%= image_tag cover_image.image,
                            class: "mx-auto max-h-[38vh] w-auto rounded-xl object-contain" %>
            <% end %>
          <% end %>

          <div class="p-8 md:p-10">
            <h2 class="text-2xl font-semibold text-[#4F4B43]">
              <%= link_to project.name,
                          project_path(project),
                          class: "transition hover:text-[#77736A]" %>
            </h2>

            <p class="mt-3 text-lg text-[#77736A]">
              <%= project.summary %>
            </p>

            <div class="mt-5 flex flex-wrap gap-2">
              <% project.skills.each do |skill| %>
                <%= render "shared/badge", text: skill.name %>
              <% end %>
            </div>
          </div>

        </article>
      <% end %>
    </div>
  </div>
</div>