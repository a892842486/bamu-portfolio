<div class="bg-[#F5F1E8] px-4 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-20 text-center">
      <h1 class="text-5xl font-semibold tracking-tight text-[#25231F]">
        My Projects
      </h1>

      <p class="mt-4 text-lg text-[#77736A]">
        Projects I've built while learning and exploring web development.
      </p>
    </div>


    <div class="grid gap-6 md:grid-cols-2">
      <% @projects.each do |project| %>
        <div class="rounded-xl bg-[#EEEAE0] p-12">
          <h2 class="text-xl font-semibold">
            <%= link_to project.name, project_path(project), class: "hover:underline" %>
          </h2>

          <p class="mt-2 text-gray-600"><%= project.summary %></p>

          <div class="mt-3 flex flex-wrap gap-2">
            <% project.skills.each do |skill| %>
              <%= render "shared/badge", text: skill.name %>
            <% end %>
          </div>

          <% cover_image = project.project_images.order(:created_at).first %>

          <% if cover_image&.image&.attached? %>
            <%= link_to project_path(project) do %>
              <%= image_tag cover_image.image, class: "mt-6 w-full rounded-lg" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>