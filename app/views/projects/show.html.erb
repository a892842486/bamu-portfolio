<div class="bg-[#F5F1E8] p-8">
  <div class="mx-auto max-w-6xl">

    <div class="max-w-3xl">
      <h1 class="text-5xl font-semibold tracking-tight text-[#25231F]">
        <%= @project.name %>
      </h1>

      <p class="mt-5 text-lg leading-8 text-[#77736A]">
        <%= @project.summary %>
      </p>
    </div>

    <h2 class="mt-14 flex items-center gap-3 text-2xl font-semibold text-[#4F4B43]">
      <span class="relative inline-block h-2.5 w-2 rounded-[100%_0_100%_0] border border-[#7B806F]">
        <span class="absolute left-1/2 top-1/2 h-px w-1 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-[#7B806F]"></span>
      </span>
      About this project
    </h2>

    <div class="mt-8 max-w-3xl leading-7 text-[#77736A]">
      <%= simple_format(@project.description) %>
    </div>

    <h2 class="mt-10 flex items-center gap-3 text-2xl font-semibold text-[#4F4B43]">
      <span class="relative inline-block h-2.5 w-2 rounded-[100%_0_100%_0] border border-[#7B806F]">
        <span class="absolute left-1/2 top-1/2 h-px w-1 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-[#7B806F]"></span>
      </span>
      Skills
    </h2>

    <div class="mt-3 flex flex-wrap gap-2">
      <% @project.skills.order(:position).each do |skill| %>
        <%= render "shared/badge", text: skill.name %>
      <% end %>
    </div>

    <h2 class="mt-10 flex items-center gap-3 text-2xl font-semibold text-[#4F4B43]">
      <span class="relative inline-block h-2.5 w-2 rounded-[100%_0_100%_0] border border-[#7B806F]">
        <span class="absolute left-1/2 top-1/2 h-px w-1 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-[#7B806F]"></span>
      </span>
      Links
    </h2>

    <div class="mt-3 mb-8 flex flex-wrap gap-2">
      <% @project.links.each do |link| %>
        <%= render "shared/link", link: link %>
      <% end %>
    </div>

    <% if @project.project_images.any? %>
      <h2 class="mt-10 flex items-center gap-3 text-2xl font-semibold text-[#4F4B43]">
        <span class="relative inline-block h-2.5 w-2 rounded-[100%_0_100%_0] border border-[#7B806F]">
          <span class="absolute left-1/2 top-1/2 h-px w-1 -translate-x-1/2 -translate-y-1/2 rotate-45 bg-[#7B806F]"></span>
        </span>
        Project Screenshots
      </h2>

      <div class="mt-6 space-y-8">
        <% @project.project_images.order(:created_at).each do |project_image| %>
          <% if project_image.image.attached? %>
            <div>
              <%= image_tag project_image.image,
                            class: "w-full max-w-3xl rounded-xl shadow-sm" %>

              <% if project_image.caption.present? %>
                <p class="mt-3 text-sm text-[#77736A]">
                  <%= project_image.caption %>
                </p>
              <% end %>
            </div>
          <% end %>
        <% end %>
    </div>
    
    <% end %>
  </div>
</div>